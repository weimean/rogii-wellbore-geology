# --- Competition data (never commit — redistribution violates comp rules) ---
# Ignore the *contents* not the directory, so README/.gitkeep can be re-included.
data/*
!data/README.md

# --- Models & outputs ---
models/*
!models/.gitkeep
outputs/*
!outputs/.gitkeep

# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
.python-version.local
.ipynb_checkpoints/

# --- Secrets ---
kaggle.json
.env

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
